// ============================================================
// Cohort LMS Schema (Optimized for 10 Students & 2 Mentors/Admins)
// Simplified: No departments, programs, or super admin bureaucracy.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MENTOR   // Admin / Mentor
  STUDENT  // Cohort Student
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_DUTY
}

enum SubmissionStatus {
  ASSIGNED
  SUBMITTED
  GRADED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(STUDENT)
  avatarUrl    String?
  createdAt    DateTime  @default(now())

  // Student specific relations
  mentorId          String?
  mentor            User?             @relation("MentorMentees", fields: [mentorId], references: [id])
  mentees           User[]            @relation("MentorMentees")
  attendanceRecords AttendanceRecord[]
  submissions       Submission[]
  notifications     Notification[]
  createdTasks      Task[]            @relation("MentorTasks")

  @@map("users")
}

model AttendanceSession {
  id          String             @id @default(cuid())
  title       String             // e.g. "Sprint 1 Standup & Lecture"
  sessionDate DateTime           @default(now())
  createdById String
  createdAt   DateTime           @default(now())
  records     AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus  @default(PRESENT)
  remarks   String?
  markedAt  DateTime          @default(now())

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String
  maxScore     Float        @default(100)
  dueDate      DateTime
  createdById  String
  createdBy    User         @relation("MentorTasks", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  submissions  Submission[]

  @@map("tasks")
}

model Submission {
  id           String           @id @default(cuid())
  taskId       String
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String           // Solution text or Git / project link
  status       SubmissionStatus @default(SUBMITTED)
  score        Float?           // Evaluated score
  feedback     String?          // Mentor feedback
  isLate       Boolean          @default(false)
  submittedAt  DateTime         @default(now())
  evaluatedAt  DateTime?

  @@unique([taskId, studentId])
  @@map("submissions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
